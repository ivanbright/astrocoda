# ---------------------------------------------------------------------------
# Astrocoda - environment baseline
#
#   cp .env.example .env
#
# Required settings are validated by app/core/config.py on boot. The process
# refuses to start if any of them is missing or malformed.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Required: external services ---------------------------------------------
POSTGRES_URI=postgresql+asyncpg://astrocoda:astrocoda_dev_password@postgres:5432/astrocoda
REDIS_URI=redis://redis:6379
OPENAI_API_KEY=sk-replace_me
# Optional: OpenAI-compatible provider gateway. Leave unset for api.openai.com.
# Example (OpenRouter): OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                      OPENAI_CHAT_MODEL=openai/gpt-4o-mini
#                      OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_BASE_URL=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SECRET_KEY=replace_me_with_at_least_32_random_characters

# --- Required when running outside Docker ------------------------------------
# docker-compose.yml rewrites POSTGRES_URI / REDIS_URI / QDRANT_URL to the
# container network automatically, so only change these for a local venv.
# POSTGRES_URI=postgresql+asyncpg://astrocoda:astrocoda_dev_password@localhost:5432/astrocoda
# REDIS_URI=redis://localhost:6379
# QDRANT_URL=http://localhost:6333

# --- Local infrastructure credentials (used by docker-compose) ---------------
POSTGRES_USER=astrocoda
POSTGRES_PASSWORD=astrocoda_dev_password
POSTGRES_DB=astrocoda
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_LOG_LEVEL=INFO
WEB_PORT=8000

# --- AI pipeline tuning ------------------------------------------------------
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
MAX_DOCUMENT_CHARACTERS=1000000
VECTOR_COLLECTION_NAME=astrocoda_chunks
INSTRUCTOR_MAX_RETRIES=3
LLM_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
ARQ_JOB_TIMEOUT=1800
ARQ_MAX_TRIES=3

# --- Authentication ----------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_PREFIX=astro_
